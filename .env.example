APP_NAME="Panitia Akhir Zaman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL publik aplikasi, termasuk https dan domain jika sudah tersedia.
APP_URL=http://localhost:2005
# Port host Docker yang dipakai aplikasi.
APP_PORT=2005

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# MySQL di mesin server yang sama: host.docker.internal
# MySQL di mesin lain: isi IP atau hostname database tersebut.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=panitia
DB_USERNAME=change_me
DB_PASSWORD=change_me

# whatsapp
Whatsapp_UrlApi=
Whatsapp_Username=
Whatsapp_Password=
Whatsapp_key=

# QRIS Payment Gateway
QRIS_API_KEY=your_api_key_here
WEBHOOK_URL=https://yourdomain.com/api/webhook/qris

# mqtt
MQTT_BROKER=
CLIENT_ID=
MQTT_SUBSCRIBE=

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=storage/app/google-drive/service-account.json
FFMPEG_BIN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
